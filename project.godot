[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=false

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
shading/overrides/force_vertex_shading=false
limits/cluster_builder/max_clustered_elements=512

[shader_globals]

wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
wind_strength={
"type": "float",
"value": 0.5
}
wetness={
"type": "float",
"value": 0.0
}
rain_intensity={
"type": "float",
"value": 0.0
}
detail_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
grass_view_distance={
"type": "float",
"value": 100.0
}
grass_density_scale={
"type": "float",
"value": 1.0
}
sky_light_color={
"type": "color",
"value": Color(0.6, 0.65, 0.7, 1)
}
